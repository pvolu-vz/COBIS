# ─────────────────────────────────────────────────────────────
#  COBIS → Veza OAA Integration — Environment Configuration
# ─────────────────────────────────────────────────────────────

# Veza Configuration
VEZA_URL=https://your-company.vezacloud.com
VEZA_API_KEY=your_veza_api_key_here

# ── Excel Source — Option 1: Local or Mounted Path ──────────
# Use this if the SMB share is already mounted (e.g. via /etc/fstab)
COBIS_XLSX_PATH=/mnt/cobis-share/reports/FBIC_Users_By_Group.xls

# ── Excel Source — Option 2: Direct SMB Access ──────────────
# Use these if you want the script to fetch the file via SMB directly
# COBIS_SMB_SERVER=fileserver.example.com
# COBIS_SMB_SHARE=cobis-reports
# COBIS_SMB_PATH=reports/FBIC_Users_By_Group.xls
# COBIS_SMB_USERNAME=svc_cobis_reader
# COBIS_SMB_PASSWORD=your_smb_password_here
# COBIS_SMB_PORT=445

# ── Last-Logon Report (optional) ────────────────────────────
# Path to the T27991126A-style XLSX containing user last-login timestamps
# COBIS_LAST_LOGON_PATH=/mnt/cobis-share/reports/T27991126A.xlsx

# ── OAA Provider Settings (optional overrides) ─────────────
# PROVIDER_NAME=COBIS
# DATASOURCE_NAME=COBIS
